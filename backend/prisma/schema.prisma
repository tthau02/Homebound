generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  username     String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  profile      PlayerProfile?
  tickets      BusTicket[]
  sentMessages ChatMessage[]  @relation("SentMessages")
}

model PlayerProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String
  avatar        String   @default("🧑‍🚀")
  shirtColor    String   @default("#f59e0b")
  walletBalance Int      @default(1000000)
  currentRoomId String?
  updatedAt     DateTime @updatedAt
}

model BusRoute {
  id              String       @id
  name            String
  origin          String
  destination     String
  totalDistanceKm Float
  ticketPrice     Int          @default(180000)
  stops           BusStop[]
  rooms           BusRoom[]
  journeys        BusJourney[]
  createdAt       DateTime     @default(now())
}

model BusStop {
  id          String   @id
  routeId     String
  route       BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  distanceKm  Float
  description String

  @@index([routeId, order])
}

model BusRoom {
  id          String        @id @default(uuid())
  name        String
  routeId     String
  route       BusRoute      @relation(fields: [routeId], references: [id])
  maxPlayers  Int           @default(28)
  status      String        @default("WAITING")
  ownerId     String?
  driverId    String?
  assistantId String?
  journeys    BusJourney[]
  messages    ChatMessage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model BusJourney {
  id               String      @id @default(uuid())
  roomId           String
  room             BusRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  routeId          String
  route            BusRoute    @relation(fields: [routeId], references: [id])
  currentStopOrder Int         @default(0)
  status           String      @default("IDLE")
  departureTime    DateTime?
  arrivalTime      DateTime?
  tickets          BusTicket[]
  createdAt        DateTime    @default(now())
}

model BusTicket {
  id                 String     @id @default(uuid())
  playerId           String
  player             User       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  journeyId          String
  journey            BusJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  roomId             String
  seatId             String
  price              Int
  status             String     @default("BOOKED")
  paidAt             DateTime?
  checkedByAssistant Boolean    @default(false)
  createdAt          DateTime   @default(now())

  @@unique([journeyId, seatId])
}

model ChatMessage {
  id          String   @id @default(uuid())
  roomId      String
  room        BusRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String?
  content     String
  scope       String   @default("PUBLIC")
  createdAt   DateTime @default(now())

  @@index([roomId, createdAt])
}
